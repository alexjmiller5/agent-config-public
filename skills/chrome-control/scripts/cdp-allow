#!/bin/bash
# Auto-approve Chrome's "Allow remote debugging?" sheet (Tier 2, chrome://inspect
# approval mode). Chrome raises that sheet on EVERY new CDP websocket connection;
# this clicks Allow via macOS UI scripting so an agent's own connection needs no
# human. Polls for the sheet for up to $1 seconds (default 20), exits 0 when
# clicked, 1 if it never appeared. Needs Accessibility permission for the
# calling process (System Settings > Privacy & Security > Accessibility).
# Only ever approves while running - it is not a standing allowlist.
secs="${1:-20}"
deadline=$(( $(date +%s) + secs ))
while [ "$(date +%s)" -lt "$deadline" ]; do
  result=$(osascript <<'APPLESCRIPT' 2>/dev/null
tell application "System Events"
  if not (exists process "Google Chrome") then return "no-chrome"
  tell process "Google Chrome"
    repeat with w in windows
      repeat with sh in sheets of w
        if name of sh is "Allow remote debugging?" then
          set allEls to entire contents of sh
          repeat with el in allEls
            try
              if role of el is "AXButton" and description of el is "Allow" then
                click el
                return "clicked"
              end if
            end try
          end repeat
        end if
      end repeat
    end repeat
  end tell
  return "not-yet"
end tell
APPLESCRIPT
)
  case "$result" in
    clicked) echo "cdp-allow: approved" >&2; exit 0 ;;
    no-chrome) echo "cdp-allow: Chrome is not running" >&2; exit 1 ;;
  esac
  sleep 0.5
done
echo "cdp-allow: no dialog within ${secs}s" >&2; exit 1
