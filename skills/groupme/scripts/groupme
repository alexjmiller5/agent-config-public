#!/usr/bin/env python3
# /// script
# requires-python = ">=3.11"
# ///
"""Read-only GroupMe history: list groups and DMs, read a window, regex-search a whole conversation.

Auth: GROUPME_TOKEN env var (dev.groupme.com > Access Token). Only GET requests are ever made.
A conversation is a group id, a unique piece of a group's name, or dm:<other_user_id> for a DM thread.
Output: NDJSON on stdout; scan accounting on stderr.

search reads a local archive (GROUPME_ARCHIVE, default ~/.cache/groupme/archive.sqlite). The first search of a
conversation pages its whole history into it (minutes for a big group); every later search fetches only what is new.
"""

import argparse
import json
import os
import re
import sqlite3
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from contextlib import closing
from datetime import UTC, datetime

API = "https://api.groupme.com/v3"
OUT = threading.Lock()


class ApiError(Exception):
    def __init__(self, code, path, body):
        hint = " (a group you left no longer serves its messages)" if code == 404 and "/groups/" in path else ""
        super().__init__(f"groupme: HTTP {code} on {path}{hint}: {body}")


def get(path, params):
    """GET an API path; returns the `response` payload, or None when GroupMe answers 304 (nothing more)."""
    token = os.environ.get("GROUPME_TOKEN")
    if not token:
        sys.exit("groupme: set GROUPME_TOKEN (dev.groupme.com > Access Token)")
    url = f"{API}{path}?{urllib.parse.urlencode(params)}"
    for attempt in range(4):
        try:
            req = urllib.request.Request(url, headers={"X-Access-Token": token})
            with urllib.request.urlopen(req, timeout=30) as r:
                return json.load(r)["response"]
        except urllib.error.HTTPError as e:
            if e.code == 304:
                return None
            if e.code == 429 and attempt < 3:
                time.sleep(5 * 2**attempt)
                continue
            raise ApiError(e.code, path, e.read()[:200].decode(errors="replace")) from None


def iso(ts):
    return datetime.fromtimestamp(ts, UTC).strftime("%Y-%m-%dT%H:%M:%SZ")


def epoch(s):
    d = datetime.fromisoformat(s)
    return (d if d.tzinfo else d.replace(tzinfo=UTC)).timestamp()


def emit(row):
    with OUT:
        print(json.dumps(row, ensure_ascii=False), flush=True)


def shape(m):
    atts = []
    for a in m.get("attachments") or []:
        if a.get("type") in ("emoji", "mentions"):
            continue
        ref = a.get("url") or a.get("reply_id") or a.get("name")
        atts.append(f"{a.get('type')} {ref}" if ref else str(a.get("type")))
    return {
        "id": m["id"],
        "at": iso(m["created_at"]),
        "name": m.get("name"),
        "text": m.get("text") or "",
        "likes": len(m.get("favorited_by") or []),
        "attachments": atts,
    }


def resolve(conv):
    """A group id or dm: id passes through; anything else must match exactly one active group's name."""
    if conv.isdigit() or conv.startswith("dm:"):
        return conv
    found = [g for g in listing("/groups") if conv.lower() in (g.get("name") or "").lower()]
    if len(found) != 1:
        names = ", ".join(f"{g['id']} {g.get('name')}" for g in found) or "none"
        sys.exit(f"groupme: '{conv}' must match exactly one group you are in; matches: {names}")
    return found[0]["id"]


def conversation(conv):
    if conv.startswith("dm:"):
        return "/direct_messages", {"other_user_id": conv[3:]}, "direct_messages"
    return f"/groups/{conv}/messages", {"limit": 100}, "messages"


def pages(conv, before_id=None):
    """Pages of messages, newest first, until history runs out."""
    path, base, key = conversation(conv)
    while True:
        params = dict(base, **({"before_id": before_id} if before_id else {}))
        rows = (get(path, params) or {}).get(key) or []
        if not rows:
            return
        yield rows
        before_id = rows[-1]["id"]


def walk(conv, before_id=None):
    for page in pages(conv, before_id):
        yield from page


def archive():
    path = os.environ.get("GROUPME_ARCHIVE") or os.path.join(
        os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "groupme", "archive.sqlite"
    )
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    db = sqlite3.connect(path, timeout=120)
    os.chmod(path, 0o600)  # other people's messages: owner-only
    db.execute("PRAGMA journal_mode=WAL")
    db.executescript(
        """CREATE TABLE IF NOT EXISTS messages (conv TEXT, id TEXT, created_at INTEGER, raw TEXT, PRIMARY KEY (conv, id));
        CREATE INDEX IF NOT EXISTS messages_time ON messages (conv, created_at);
        CREATE TABLE IF NOT EXISTS backfill (conv TEXT PRIMARY KEY, oldest_id TEXT, complete INTEGER NOT NULL DEFAULT 0);"""
    )
    return db


def store(db, conv, page):
    """Upsert one page (likes change after the fact); returns how many of its messages were already archived."""
    ids = [m["id"] for m in page]
    known = db.execute(
        f"SELECT count(*) FROM messages WHERE conv = ? AND id IN ({','.join('?' * len(ids))})", (conv, *ids)
    ).fetchone()[0]
    db.executemany(
        "INSERT OR REPLACE INTO messages VALUES (?, ?, ?, ?)",
        [(conv, m["id"], m["created_at"], json.dumps(m)) for m in page],
    )
    return known


def sync(db, conv):
    """Newest pages until one is fully archived, then finish an interrupted backfill. Progress commits per page."""
    row = db.execute("SELECT oldest_id, complete FROM backfill WHERE conv = ?", (conv,)).fetchone()
    fresh = row is None
    oldest, complete = row or (None, 0)
    if fresh:
        db.execute("INSERT INTO backfill (conv) VALUES (?)", (conv,))
        db.commit()
    for page in pages(conv):
        known = store(db, conv, page)
        if fresh:  # on a first sync the head walk is the backfill
            oldest = page[-1]["id"]
            db.execute("UPDATE backfill SET oldest_id = ? WHERE conv = ?", (oldest, conv))
        db.commit()
        if known == len(page):
            break
    else:
        complete = 1
    if not complete and oldest:
        for page in pages(conv, oldest):
            store(db, conv, page)
            db.execute("UPDATE backfill SET oldest_id = ? WHERE conv = ?", (page[-1]["id"], conv))
            db.commit()
    db.execute("UPDATE backfill SET complete = 1 WHERE conv = ?", (conv,))
    db.commit()


def forward(conv, after_id):
    """Group messages oldest first, starting right after a message id."""
    path, base, key = conversation(conv)
    if key != "messages":
        sys.exit("groupme: --after-id works for groups only; page DMs back with --before-id")
    while rows := (get(path, dict(base, after_id=after_id)) or {}).get(key):
        yield from rows
        after_id = rows[-1]["id"]


def listing(path, paged=True):
    page = 1
    while rows := get(path, {"page": page, "per_page": 100, "omit": "memberships"} if paged else {}):
        yield from rows
        if not paged:
            return
        page += 1


def cmd_groups(_):
    for former, path, paged in ((False, "/groups", True), (True, "/groups/former", False)):
        for g in listing(path, paged):
            last = (g.get("messages") or {}).get("last_message_created_at")
            emit(
                {
                    "id": g["id"],
                    "name": g.get("name"),
                    "former": former,
                    "messages": (g.get("messages") or {}).get("count"),
                    "last": iso(last) if last else None,
                }
            )


def cmd_chats(_):
    for c in listing("/chats"):
        u, last = c.get("other_user") or {}, (c.get("last_message") or {}).get("created_at")
        emit(
            {
                "id": f"dm:{u.get('id')}",
                "name": u.get("name"),
                "messages": c.get("messages_count"),
                "last": iso(last) if last else None,
            }
        )


def scan(conv, a, label=None):
    pattern, since = re.compile(a.pattern, re.IGNORECASE), epoch(a.since) if a.since else 0
    sender = (a.sender or "").lower()
    scanned = hits = 0
    oldest = None
    with closing(archive()) as db:
        sync(db, conv)
        rows = db.execute(
            "SELECT raw FROM messages WHERE conv = ? AND created_at >= ? ORDER BY created_at DESC, length(id) DESC, id DESC",
            (conv, since),
        ).fetchall()
    for (raw,) in rows:
        m = json.loads(raw)
        scanned, oldest = scanned + 1, m["created_at"]
        if pattern.search(m.get("text") or "") and sender in (m.get("name") or "").lower():
            hits += 1
            emit(shape(m) | ({"group": label} if label else {}))
    back = iso(oldest) if oldest is not None else "-"
    print(
        f"groupme: {hits} hits in {scanned} messages, back to {back}{f' in {label}' if label else ''}", file=sys.stderr
    )


def every_group(fn):
    def one(g):
        try:
            fn(g)
        except ApiError as e:
            print(f"{e} in {g.get('name')}", file=sys.stderr)

    # ponytail: 6 groups at a time; lower it if GroupMe starts answering 429
    with ThreadPoolExecutor(6) as pool:
        list(pool.map(one, listing("/groups")))


def cmd_search(a):
    if a.conversation != "all":
        return scan(resolve(a.conversation), a)
    every_group(lambda g: scan(g["id"], a, g.get("name")))


def cmd_sync(a):
    def one(conv, label):
        with closing(archive()) as db:
            sync(db, conv)
            n = db.execute("SELECT count(*) FROM messages WHERE conv = ?", (conv,)).fetchone()[0]
        print(f"groupme: {n} messages archived for {label}", file=sys.stderr)

    if a.conversation != "all":
        return one(resolve(a.conversation), a.conversation)
    every_group(lambda g: one(g["id"], g.get("name")))


def cmd_history(a):
    conv = resolve(a.conversation)
    rows = forward(conv, a.after_id) if a.after_id else walk(conv, a.before_id)
    for i, m in enumerate(rows):
        if i >= a.limit:
            break
        emit(shape(m))


def main(argv=None):
    p = argparse.ArgumentParser(
        prog="groupme", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    sub = p.add_subparsers(required=True)
    sub.add_parser("groups", help="groups you are in, then groups you left (former=true)").set_defaults(fn=cmd_groups)
    sub.add_parser("chats", help="direct-message threads; id is dm:<other_user_id>").set_defaults(fn=cmd_chats)
    s = sub.add_parser("search", help="case-insensitive regex over every message text, newest first")
    s.add_argument("conversation", help="a conversation, or all = every group you are in (hits carry the group name)")
    s.add_argument("pattern", help="regex; '' matches every message (use with --from)")
    s.add_argument("--from", dest="sender", help="only messages whose sender name contains this (case-insensitive)")
    s.add_argument("--since", help="only messages at or after this UTC date/datetime (YYYY-MM-DD[THH:MM:SS])")
    s.set_defaults(fn=cmd_search)
    y = sub.add_parser("sync", help="build or refresh the local archive (all = every group you are in)")
    y.add_argument("conversation")
    y.set_defaults(fn=cmd_sync)
    h = sub.add_parser(
        "history", help="read a window: latest, before a message (newest first), or after it (oldest first)"
    )
    h.add_argument("conversation")
    w = h.add_mutually_exclusive_group()
    w.add_argument("--before-id")
    w.add_argument("--after-id")
    h.add_argument("--limit", type=int, default=50)
    h.set_defaults(fn=cmd_history)
    a = p.parse_args(argv)
    try:
        a.fn(a)
    except ApiError as e:
        sys.exit(str(e))


if __name__ == "__main__":
    main()
